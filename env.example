# Database
DATABASE_URL="postgresql://user:password@localhost:5432/gcs_db?schema=public"

# NextAuth.js
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-nextauth-secret-key-here"

# Kakao OAuth (NextAuth)
KAKAO_CLIENT_ID="your-kakao-client-id"
KAKAO_CLIENT_SECRET="your-kakao-client-secret"

# Brevo (Email)
BREVO_API_KEY="xkeysib-xxxxxxxx"
BREVO_FROM_EMAIL="noreply@yourdomain.com"

# 포트원 (Buy Now + Fund 통합)
PORTONE_STORE_ID=""
# 하위 상점에 실결제 채널만 연결한 경우: 콘솔 하위 상점 상세의 Store ID(상점아이디)를 넣음. 비우면 PORTONE_STORE_ID 사용
# PORTONE_CHECKOUT_STORE_ID=""
PORTONE_CHANNEL_KEY=""          # Buy Now 결제 채널 (KG이니시스)
PORTONE_BILLING_CHANNEL_KEY=""  # Fund V2 빌링 UI용 채널 키 (브라우저 SDK). V1 onetime(현재 카드등록)은 PORTONE_BILLING_PG가 PG를 결정
PORTONE_API_SECRET=""
PORTONE_V1_IMP_CODE=""          # Fund(V1) 아임포트 REST용 고객사 식별코드(imp_xxx)
# Fund 카드등록: POST /api/v1/fund/billing/reserve → subscribe/payments/onetime 의 pg
#  - 헥토: 예 settle.nxca_jt_bi
#  - KG이니시스: html5_inicis.{PG상점아이디} (예: html5_inicis.MOI6594311). 정기/빌링 특약·MID는 이니시스에 확인
PORTONE_BILLING_PG=""
PORTONE_V1_API_KEY=""           # Fund(V1) 서버 결제용 REST API Key
PORTONE_V1_API_SECRET=""        # Fund(V1) 서버 결제용 REST API Secret
# PORTONE_BILLING_AUTH_AMOUNT=1  # 빌링키 발급 시 승인 금액(기본 1원). PG 최소금액 제한 시 100 등으로 설정
# FUND_BILLING_CANCEL_DELAY_MS=2000  # 빌링키 발급 후 취소 API 호출 전 대기(ms). 기본 2초. PG 동기화 대기용
