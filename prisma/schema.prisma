generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String                 @id @default(cuid())
  email                 String                 @unique
  password              String?
  nickname              String                 @unique
  name                  String
  phone                 String?
  memberType            Int                    @default(0)
  isSeller              Boolean                @default(false)
  studentId             String?
  major                 String?
  profileImage          String?
  isVerified            Boolean                @default(false)
  signupMethod          SignupMethod           @default(EMAIL)
  isRepresentative      Boolean                @default(false)
  failedLoginAttempts   Int                    @default(0)
  lockedUntil           DateTime?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  providerId            String?
  carts                 Cart[]
  inquiries             Inquiry[]
  likes                 Like[]
  notifications         Notification[]
  orders                Order[]
  posts                 Post[]
  productUpdateRequests ProductUpdateRequest[] @relation("ProductUpdateRequestRequestedBy")
  reviews               Review[]
  scraps                Scrap[]
  teams                 Team[]

  @@index([email])
  @@index([nickname])
  @@index([memberType])
}

model Team {
  id                     String                 @id @default(cuid())
  userId                 String
  teamName               String                 @unique
  representativeName     String
  representativeNickname String
  teamMember             String[]
  teamMemberNickname     String[]
  accountUrl             String
  totalSales             Int?
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  isSalesTeam            Boolean                @default(false)
  products               Product[]
  productUpdateRequests  ProductUpdateRequest[]
  projects               Project[]
  settlements            Settlement[]
  user                   User                   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([teamName])
}

model Product {
  id                  String                @id @default(cuid())
  teamId              String
  name                String
  description         String
  type                Int                   @default(0)
  status              Int                   @default(0)
  price               Int
  goalAmount          Int?
  currentAmount       Int                   @default(0)
  salesStartDate      DateTime
  salesEndDate        DateTime
  productionStartDate DateTime?
  deliveryStartDate   DateTime?
  receiveMethod       Int?
  isPublic            Boolean               @default(false)
  likeCount           Int                   @default(0)
  viewCount           Int                   @default(0)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  productionEndDate   DateTime?
  deliveryEndDate     DateTime?
  pickupStartDate     DateTime?
  pickupEndDate       DateTime?
  pickupLocation      String?
  isHome              Boolean               @default(false)
  isAdminApproved     Boolean               @default(false)
  publicAt            DateTime?
  cartItems           CartItem[]
  likes               Like[]
  orderItems          OrderItem[]
  team                Team                  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  images              ProductImage[]        @relation("ProductImages")
  options             ProductOption[]
  updateRequests      ProductUpdateRequest?
  variants            ProductVariant[]
  reviews             Review[]
  scraps              Scrap[]

  @@index([teamId])
  @@index([type])
  @@index([status])
  @@index([isPublic])
}

model ProductOption {
  id         String               @id @default(cuid())
  productId  String
  optionName String
  product    Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  values     ProductOptionValue[]

  @@unique([productId, optionName])
  @@index([productId])
}

model ProductOptionValue {
  id              String        @id @default(cuid())
  optionId        String
  value           String
  additionalPrice Int           @default(0)
  productId       String
  optionName      String
  option          ProductOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@unique([optionId, value])
  @@index([optionId])
  @@index([productId])
  @@index([productId, optionName])
}

model ProductVariant {
  id              String   @id @default(cuid())
  productId       String
  variantName     String?
  unitPrice       Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  isSoldOut       Boolean  @default(false)
  optionSignature String
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, optionSignature])
  @@index([productId])
  @@index([productId, isSoldOut])
}

model ProductImage {
  id              String   @id @default(cuid())
  productId       String
  thumbnailImgUrl String
  detailImgUrl    String[]
  createdAt       DateTime @default(now())
  noticeImgUrl    String
  product         Product  @relation("ProductImages", fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ProductUpdateRequest {
  id                  String                       @id @default(cuid())
  productId           String                       @unique
  requestedByUserId   String
  teamId              String
  requestType         Int                          @default(0)
  name                String
  description         String
  type                Int                          @default(0)
  status              Int                          @default(0)
  price               Int
  goalAmount          Int?
  salesStartDate      DateTime
  salesEndDate        DateTime
  productionStartDate DateTime?
  productionEndDate   DateTime?
  deliveryStartDate   DateTime?
  deliveryEndDate     DateTime?
  pickupStartDate     DateTime?
  pickupEndDate       DateTime?
  pickupLocation      String?
  receiveMethod       Int?
  requestedAt         DateTime                     @default(now())
  updatedAt           DateTime                     @updatedAt
  product             Product                      @relation(fields: [productId], references: [id], onDelete: Cascade)
  requestedBy         User                         @relation("ProductUpdateRequestRequestedBy", fields: [requestedByUserId], references: [id], onDelete: Cascade)
  team                Team                         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  images              ProductUpdateRequestImage[]
  options             ProductUpdateRequestOption[]

  @@index([productId])
  @@index([requestedByUserId])
  @@index([teamId])
  @@index([requestType])
  @@index([requestedAt])
}

model ProductUpdateRequestImage {
  id                     String               @id @default(cuid())
  productUpdateRequestId String
  thumbnailImgUrl        String
  detailImgUrl           String[]
  noticeImgUrl           String?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  productUpdateRequest   ProductUpdateRequest @relation(fields: [productUpdateRequestId], references: [id], onDelete: Cascade)

  @@index([productUpdateRequestId])
}

model ProductUpdateRequestOption {
  id                     String                            @id @default(cuid())
  productUpdateRequestId String
  optionName             String
  productUpdateRequest   ProductUpdateRequest              @relation(fields: [productUpdateRequestId], references: [id], onDelete: Cascade)
  values                 ProductUpdateRequestOptionValue[]

  @@unique([productUpdateRequestId, optionName])
  @@index([productUpdateRequestId])
}

model ProductUpdateRequestOptionValue {
  id              String                     @id @default(cuid())
  optionId        String
  value           String
  additionalPrice Int                        @default(0)
  productId       String
  optionName      String
  option          ProductUpdateRequestOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@unique([optionId, value])
  @@index([optionId])
  @@index([productId])
  @@index([productId, optionName])
}

model Order {
  id                    String      @id @default(cuid())
  userId                String?
  buyerType             BuyerType
  buyerGuestTokenHash   String?
  paymentAmount         Int
  orderDate             DateTime    @default(now())
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  productType           Int
  receiveMethod         Int
  receiverName          String?
  receiverPhone         String?
  deliveryZipCode       String?
  deliveryAddressMain   String?
  deliveryAddressDetail String?
  deliveryMessage       String?
  ordererName           String?
  ordererPhone          String?
  paymentStatus         Int         @default(0)
  fulfillmentStatus     Int?
  paymentMethod         Int
  cardCompany           Int?
  bankCode              Int?
  easyPayProvider       Int?
  billingKey            String?
  orderDateKey          String?
  orderSeq              Int?
  orderCode             String?     @unique
  inquiries             Inquiry[]
  user                  User?       @relation(fields: [userId], references: [id])
  items                 OrderItem[]

  @@unique([orderDateKey, productType, orderSeq])
  @@index([userId])
  @@index([productType, receiveMethod])
  @@index([paymentStatus])
  @@index([fulfillmentStatus])
  @@index([orderDate])
  @@index([orderDateKey, productType])
  @@index([bankCode])
  @@index([cardCompany])
  @@index([easyPayProvider])
}

model OrderSequence {
  orderDateKey String
  productType  Int
  lastSeq      Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@id([orderDateKey, productType])
}

model OrderItem {
  id         String   @id @default(cuid())
  orderId    String
  productId  String
  productType Int
  quantity   Int
  price      Int
  optionData Json?
  createdAt  DateTime @default(now())
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
}

model Scrap {
  id        String   @id @default(cuid())
  userId    String
  projectId String?
  productId String?
  createdAt DateTime @default(now())
  postId    String?
  post      Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  product   Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
  @@unique([userId, productId])
  @@unique([userId, postId])
  @@index([userId])
  @@index([projectId])
  @@index([productId])
  @@index([postId])
}

model Review {
  id        String        @id @default(cuid())
  userId    String
  productId String
  orderId   String?
  rating    Int
  content   String
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  product   Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  images    ReviewImage[]

  @@index([userId])
  @@index([productId])
  @@index([rating])
}

model ReviewImage {
  id        String   @id @default(cuid())
  reviewId  String
  url       String[]
  createdAt DateTime @default(now())
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([reviewId])
}

model Image {
  id        String   @id @default(cuid()) @map("imageId")
  usage     String
  fileSize  Int
  mimeType  String
  imageUrl  String   @default("")
  data      Bytes?
  createdAt DateTime @default(now())

  @@index([usage])
  @@map("Image")
}

model Post {
  id           String   @id @default(cuid())
  userId       String
  category     Int      @default(0)
  title        String
  subTitle     String?
  content      String
  thumbnailUrl String?
  images       String[]
  likeCount    Int      @default(0)
  viewCount    Int      @default(0)
  isPublic     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  likes        Like[]
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  scraps       Scrap[]

  @@index([userId])
  @@index([category])
  @@index([isPublic])
  @@index([createdAt])
}

model Category {
  id       String @id @default(cuid())
  category String @unique
}

model ProjectCategory {
  id       String    @id @default(cuid()) @map("categoryId")
  category String
  projects Project[]

  @@map("Project Category")
}

model ProjectYear {
  id       String    @id @default(cuid()) @map("yearId")
  year     Int
  projects Project[]

  @@map("Proejct Year")
}

model Project {
  title         String
  likeCount     Int             @default(0)
  viewCount     Int             @default(0)
  isPublic      Boolean         @default(false)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  categoryId    String
  detailUrl     String
  hardDeleteAt  DateTime?
  isHome        Boolean         @default(false) @map("ishome")
  id            String          @id @default(cuid()) @map("projectId")
  softDeletedAt DateTime?
  teamId        String
  thumbnailUrl  String
  yearId        String
  likes         Like[]
  category      ProjectCategory @relation(fields: [categoryId], references: [id])
  team          Team            @relation(fields: [teamId], references: [id], onDelete: Cascade)
  projectYear   ProjectYear     @relation(fields: [yearId], references: [id])
  scraps        Scrap[]

  @@index([teamId])
  @@index([categoryId])
  @@index([yearId])
  @@index([isPublic])
  @@index([isHome])
  @@index([softDeletedAt])
}

model News {
  id              String    @id @default(cuid())
  title           String
  startDate       DateTime?
  endDate         DateTime?
  thumbnailImgUrl String?
  detailImgUrl    String[]
  isHeadline      Boolean   @default(false)
  likeCount       Int       @default(0)
  viewCount       Int       @default(0)
  isPublic        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  likes           Like[]

  @@index([isHeadline])
  @@index([isPublic])
}

model Inquiry {
  id        String   @id @default(cuid())
  userId    String
  orderId   String?
  content   String
  status    Int      @default(0)
  createdAt DateTime @default(now())
  order     Order?   @relation(fields: [orderId], references: [id])
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([orderId])
  @@index([status])
}

model Settlement {
  id                  String    @id @default(cuid())
  orderId             String?
  teamId              String
  teamName            String
  grossAmount         Int
  productionCost      Int       @default(0)
  refundAmount        Int       @default(0)
  feeAmount           Int       @default(0)
  paidDate            DateTime?
  attachmentUrl       String?
  settlementStartDate DateTime
  settlementEndDate   DateTime
  status              Int       @default(0)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  team                Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId])
  @@index([status])
  @@index([settlementStartDate, settlementEndDate])
}

model Like {
  id        String   @id @default(cuid())
  userId    String
  productId String?
  postId    String?
  projectId String?
  newsId    String?
  createdAt DateTime @default(now())
  news      News?    @relation(fields: [newsId], references: [id], onDelete: Cascade)
  post      Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  product   Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@unique([userId, postId])
  @@unique([userId, projectId])
  @@unique([userId, newsId])
  @@index([userId])
}

model VerificationToken {
  id         String   @id @default(cuid())
  identifier String
  token      String   @unique
  expires    DateTime
  createdAt  DateTime @default(now())

  @@unique([identifier, token])
  @@index([identifier])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      Int      @default(0)
  title     String
  content   String?
  isRead    Boolean  @default(false)
  linkUrl   String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
}

model Cart {
  id        String     @id @default(cuid())
  userId    String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]

  @@index([userId])
}

model CartItem {
  id         String   @id @default(cuid())
  cartId     String
  productId  String
  quantity   Int      @default(1)
  price      Int
  optionData Json?
  createdAt  DateTime @default(now())
  cart       Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([cartId])
  @@index([productId])
}

model Term {
  id        String   @id @default(cuid())
  type      String
  mainTitle String
  subTitle  String?
  body      String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@index([order])
}

enum SignupMethod {
  EMAIL
  KAKAO
}

enum BuyerType {
  USER
  GUEST
}
