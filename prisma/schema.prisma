generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String         @id @default(cuid())
  email               String         @unique
  password            String?
  nickname            String         @unique
  name                String
  phone               String?
  memberType          Int            @default(0)
  isSeller            Boolean        @default(false)
  studentId           String?
  major               String?
  profileImage        String?
  isVerified          Boolean        @default(false)
  signupMethod        SignupMethod   @default(EMAIL)
  isRepresentative    Boolean        @default(false)
  failedLoginAttempts Int            @default(0)
  lockedUntil         DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  providerId          String?
  carts               Cart[]
  inquiries           Inquiry[]
  likes               Like[]
  notifications       Notification[]
  orders              Order[]
  posts               Post[]
  scraps              Scrap[]
  teams               Team[]

  @@index([email])
  @@index([nickname])
  @@index([memberType])
}

model Team {
  id                     String       @id @default(cuid())
  userId                 String
  teamName               String       @unique
  representativeName     String
  representativeNickname String
  teamMember             String[]
  teamMemberNickname     String[]
  accountUrl             String
  totalSales             Int?
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt
  isSalesTeam            Boolean      @default(false)
  products               Product[]
  projects               Project[]
  settlements            Settlement[]
  user                   User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([teamName])
}

model Product {
  id                  String           @id @default(cuid())
  teamId              String
  name                String
  description         String
  type                Int              @default(0)
  status              Int              @default(0)
  price               Int
  goalAmount          Int?
  currentAmount       Int              @default(0)
  salesStartDate      DateTime
  salesEndDate        DateTime
  productionStartDate DateTime?
  deliveryStartDate   DateTime?
  receiveMethod       Int?
  isPublic            Boolean          @default(false)
  likeCount           Int              @default(0)
  viewCount           Int              @default(0)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  productionEndDate   DateTime?
  deliveryEndDate     DateTime?
  pickupStartDate     DateTime?
  pickupEndDate       DateTime?
  pickupLocation      String?
  isHome              Boolean          @default(false)
  isAdminApproved     Boolean          @default(false)
  publicAt            DateTime?
  cartItems           CartItem[]
  likes               Like[]
  orderItems          OrderItem[]
  team                Team             @relation(fields: [teamId], references: [id], onDelete: Cascade)
  images              ProductImage[]   @relation("ProductImages")
  options             ProductOption[]
  variants            ProductVariant[]
  scraps              Scrap[]

  @@index([teamId])
  @@index([type])
  @@index([status])
  @@index([isPublic])
}

model ProductOption {
  id         String               @id @default(cuid())
  productId  String
  optionName String
  product    Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  values     ProductOptionValue[]

  @@unique([productId, optionName])
  @@index([productId])
}

model ProductOptionValue {
  id              String        @id @default(cuid())
  optionId        String
  value           String
  additionalPrice Int           @default(0)
  productId       String
  optionName      String
  option          ProductOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@unique([optionId, value])
  @@index([optionId])
  @@index([productId])
  @@index([productId, optionName])
}

model ProductVariant {
  id              String   @id @default(cuid())
  productId       String
  variantName     String?
  unitPrice       Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  isSoldOut       Boolean  @default(false)
  optionSignature String
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, optionSignature])
  @@index([productId])
  @@index([productId, isSoldOut])
}

model ProductImage {
  id              String   @id @default(cuid())
  productId       String
  thumbnailImgUrl String
  detailImgUrl    String[]
  createdAt       DateTime @default(now())
  noticeImgUrl    String?
  product         Product  @relation("ProductImages", fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model Order {
  id                    String      @id @default(cuid())
  userId                String?
  paymentAmount         Int
  orderDate             DateTime    @default(now())
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  productType           Int
  receiveMethod         Int
  receiverName          String?
  receiverPhone         String?
  deliveryZipCode       String?
  deliveryAddressMain   String?
  deliveryAddressDetail String?
  deliveryMessage       String?
  ordererName           String?
  ordererPhone          String?
  paymentStatus         Int         @default(0)
  fulfillmentStatus     Int?
  paymentMethod         Int
  cardCompany           Int?
  bankCode              Int?
  easyPayProvider       Int?
  billingKey            String?
  orderDateKey          String?
  orderSeq              Int?
  orderCode             String?     @unique
  buyerType             BuyerType
  buyerGuestTokenHash   String?     @db.VarChar(128)
  bagOption             Boolean     @default(false)
  impUid                String?     @unique
  inquiries             Inquiry[]
  user                  User?       @relation(fields: [userId], references: [id])
  items                 OrderItem[]

  @@unique([orderDateKey, productType, orderSeq])
  @@index([userId])
  @@index([productType, receiveMethod])
  @@index([paymentStatus])
  @@index([fulfillmentStatus])
  @@index([orderDate])
  @@index([orderDateKey, productType])
  @@index([bankCode])
  @@index([cardCompany])
  @@index([easyPayProvider])
}

model OrderSequence {
  orderDateKey String
  productType  Int
  lastSeq      Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@id([orderDateKey, productType])
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  productId   String
  quantity    Int
  price       Int
  optionData  Json?
  createdAt   DateTime @default(now())
  productType Int
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product  @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
}

/// QRshop(/Fair) 메뉴별 재고. qrItemId 는 app/QRshop/item.json 의 id 와 동일
model FairShopProduct {
  id           String   @id @default(cuid())
  qrItemId     String   @unique
  initStock    Int
  /// 판매 가능 재고(결제 확정 시 감소)
  stock        Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  /// 미충족 수요 누적(판매 재고 0일 때 결제 시도마다 요청 수량만큼 감소 → 음수). 분석용.
  currentStock Int      @default(0)

  @@map("FairShopProductTable")
}

/// QRshop 상점. storeSlug는 상점URL 식별자
model Store {
  storeId    String                  @id @default(cuid())
  name       String
  storeSlug  String                  @unique
  createdAt  DateTime                @default(now())
  updatedAt  DateTime                @updatedAt
  categories OnsiteProductCategory[]
  products   OnsiteProduct[]
}

/// QRshop 상점별 상품 카테고리. 상품은 카테고리를 갖지 않을 수 있음
model OnsiteProductCategory {
  categoryId String          @id @default(cuid())
  storeId    String
  name       String
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  store      Store           @relation(fields: [storeId], references: [storeId], onDelete: Cascade)
  products   OnsiteProduct[]

  @@unique([storeId, name])
  @@index([storeId])
}

/// QRshop 상품. price/initStock/currentStock는 hasOption=false이면 상품 레벨에서 직접 사용.
/// hasOption=true이면 OnsiteProductOption 에서 관리하므로 상품 레벨 값은 NULL.
/// price/initStock/currentStock >= 0 은 DB CHECK 제약으로 강제(마이그레이션 참고, Prisma 스키마 문법상 표현 불가).
model OnsiteProduct {
  productId    String                 @id @default(cuid())
  storeId      String
  categoryId   String?
  name         String                 @db.VarChar(20)
  hasOption    Boolean                @default(false)
  price        Int? /// hasOption=false 일 때 필수(0 이상), hasOption=true 일 때 NULL
  initStock    Int? /// hasOption=false 일 때 필수(0 이상), hasOption=true 일 때 NULL
  currentStock Int? /// 판매 가능 재고(결제 확정 시 차감). hasOption=false 일 때 필수, hasOption=true 일 때 NULL
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  store        Store                  @relation(fields: [storeId], references: [storeId], onDelete: Cascade)
  category     OnsiteProductCategory? @relation(fields: [categoryId], references: [categoryId], onDelete: SetNull)
  options      OnsiteProductOption[]

  @@index([storeId])
  @@index([categoryId])
}

/// QRshop 상품 옵션. 상품이 hasOption=true 일 때만 사용되며, 가격/재고는 옵션 단위로 관리.
/// price/initStock/currentStock >= 0 은 DB CHECK 제약으로 강제(마이그레이션 참고, Prisma 스키마 문법상 표현 불가).
model OnsiteProductOption {
  optionId     String        @id @default(cuid())
  productId    String
  name         String        @db.VarChar(18)
  price        Int
  initStock    Int
  currentStock Int /// 판매 가능 재고(결제 확정 시 차감)
  product      OnsiteProduct @relation(fields: [productId], references: [productId], onDelete: Cascade)

  @@unique([productId, name])
  @@index([productId])
}

model Scrap {
  id        String   @id @default(cuid())
  userId    String
  projectId String?
  productId String?
  createdAt DateTime @default(now())
  postId    String?
  post      Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  product   Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
  @@unique([userId, productId])
  @@unique([userId, postId])
  @@index([userId])
  @@index([projectId])
  @@index([productId])
  @@index([postId])
}

model Image {
  id        String   @id @default(cuid()) @map("imageId")
  usage     String
  fileSize  Int
  mimeType  String
  imageUrl  String   @default("")
  data      Bytes?
  createdAt DateTime @default(now())

  @@index([usage])
  @@map("Image")
}

model Post {
  id           String   @id @default(cuid())
  userId       String
  category     Int      @default(0)
  title        String
  subTitle     String?
  content      String
  thumbnailUrl String?
  images       String[]
  likeCount    Int      @default(0)
  viewCount    Int      @default(0)
  isPublic     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  likes        Like[]
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  scraps       Scrap[]

  @@index([userId])
  @@index([category])
  @@index([isPublic])
  @@index([createdAt])
}

model Category {
  id       String @id @default(cuid())
  category String @unique
}

model ProjectCategory {
  id       String    @id @default(cuid()) @map("categoryId")
  category String
  projects Project[]

  @@map("Project Category")
}

model ProjectYear {
  id       String    @id @default(cuid()) @map("yearId")
  year     Int
  projects Project[]

  @@map("Project Year")
}

model Project {
  title         String
  likeCount     Int             @default(0)
  viewCount     Int             @default(0)
  isPublic      Boolean         @default(false)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  categoryId    String
  detailUrl     String
  hardDeleteAt  DateTime?
  isHome        Boolean         @default(false) @map("ishome")
  id            String          @id @default(cuid()) @map("projectId")
  softDeletedAt DateTime?
  teamId        String
  thumbnailUrl  String
  yearId        String
  likes         Like[]
  category      ProjectCategory @relation(fields: [categoryId], references: [id])
  team          Team            @relation(fields: [teamId], references: [id], onDelete: Cascade)
  projectYear   ProjectYear     @relation(fields: [yearId], references: [id])
  scraps        Scrap[]

  @@index([teamId])
  @@index([categoryId])
  @@index([yearId])
  @@index([isPublic])
  @@index([isHome])
  @@index([softDeletedAt])
}

model Inquiry {
  id        String   @id @default(cuid())
  userId    String
  orderId   String?
  content   String
  status    Int      @default(0)
  createdAt DateTime @default(now())
  order     Order?   @relation(fields: [orderId], references: [id])
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([orderId])
  @@index([status])
}

model Settlement {
  id                  String    @id @default(cuid())
  orderId             String?
  teamId              String
  teamName            String
  grossAmount         Int
  productionCost      Int       @default(0)
  refundAmount        Int       @default(0)
  feeAmount           Int       @default(0)
  paidDate            DateTime?
  attachmentUrl       String?
  settlementStartDate DateTime
  settlementEndDate   DateTime
  status              Int       @default(0)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  team                Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId])
  @@index([status])
  @@index([settlementStartDate, settlementEndDate])
}

model Like {
  id        String   @id @default(cuid())
  userId    String
  productId String?
  postId    String?
  projectId String?
  createdAt DateTime @default(now())
  post      Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  product   Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@unique([userId, postId])
  @@unique([userId, projectId])
  @@index([userId])
}

model VerificationToken {
  id         String   @id @default(cuid())
  identifier String
  token      String   @unique
  expires    DateTime
  createdAt  DateTime @default(now())

  @@unique([identifier, token])
  @@index([identifier])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      Int      @default(0)
  title     String
  content   String?
  isRead    Boolean  @default(false)
  linkUrl   String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
}

model Cart {
  id        String     @id @default(cuid())
  userId    String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]

  @@index([userId])
}

model CartItem {
  id         String   @id @default(cuid())
  cartId     String
  productId  String
  quantity   Int      @default(1)
  price      Int
  optionData Json?
  createdAt  DateTime @default(now())
  cart       Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([cartId])
  @@index([productId])
}

model Term {
  id        String   @id @default(cuid())
  type      String
  mainTitle String
  subTitle  String?
  body      String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@index([order])
}

enum SignupMethod {
  EMAIL
  KAKAO
}

enum BuyerType {
  USER
  GUEST
}
