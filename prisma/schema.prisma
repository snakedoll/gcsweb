generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- 유저 / 팀 ----------

model User {
  id                  String         @id @default(cuid())
  email               String         @unique
  password            String?
  nickname            String         @unique
  name                String
  phone               String?
  memberType          Int            @default(0)
  isSeller            Boolean        @default(false)
  studentId           String?
  major               String?
  profileImage        String?
  isVerified          Boolean        @default(false)
  signupMethod        SignupMethod   @default(EMAIL)
  isRepresentative    Boolean        @default(false)
  failedLoginAttempts Int            @default(0)
  lockedUntil         DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  providerId          String?
  carts               Cart[]
  inquiries           Inquiry[]
  likes               Like[]
  notifications       Notification[]
  orders              Order[]
  scraps              Scrap[]
  store               Store?
  storeStaff          StoreStaff[]
  teams               Team[]

  @@index([email])
  @@index([nickname])
  @@index([memberType])
}

model Team {
  id                     String       @id @default(cuid())
  userId                 String
  teamName               String       @unique
  representativeName     String
  representativeNickname String
  teamMember             String[]
  teamMemberNickname     String[]
  accountUrl             String
  totalSales             Int?
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt
  isSalesTeam            Boolean      @default(false)
  products               Product[]
  projects               Project[]
  user                   User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([teamName])
}

// ---------- 상품 (shop) ----------

model Product {
  id                  String           @id @default(cuid())
  teamId              String
  name                String
  description         String
  type                Int              @default(0)
  status              Int              @default(0)
  price               Int
  goalAmount          Int?
  currentAmount       Int              @default(0)
  salesStartDate      DateTime
  salesEndDate        DateTime
  productionStartDate DateTime?
  deliveryStartDate   DateTime?
  receiveMethod       Int?
  isPublic            Boolean          @default(false)
  likeCount           Int              @default(0)
  viewCount           Int              @default(0)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  productionEndDate   DateTime?
  deliveryEndDate     DateTime?
  pickupStartDate     DateTime?
  pickupEndDate       DateTime?
  pickupLocation      String?
  isHome              Boolean          @default(false)
  isAdminApproved     Boolean          @default(false)
  publicAt            DateTime?
  cartItems           CartItem[]
  likes               Like[]
  orderItems          OrderItem[]
  team                Team             @relation(fields: [teamId], references: [id], onDelete: Cascade)
  images              ProductImage[]   @relation("ProductImages")
  options             ProductOption[]
  variants            ProductVariant[]
  scraps              Scrap[]

  @@index([teamId])
  @@index([type])
  @@index([status])
  @@index([isPublic])
}

model ProductOption {
  id         String               @id @default(cuid())
  productId  String
  optionName String
  product    Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  values     ProductOptionValue[]

  @@unique([productId, optionName])
  @@index([productId])
}

model ProductOptionValue {
  id              String        @id @default(cuid())
  optionId        String
  value           String
  additionalPrice Int           @default(0)
  productId       String
  optionName      String
  option          ProductOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@unique([optionId, value])
  @@index([optionId])
  @@index([productId])
  @@index([productId, optionName])
}

model ProductVariant {
  id              String   @id @default(cuid())
  productId       String
  variantName     String?
  unitPrice       Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  isSoldOut       Boolean  @default(false)
  optionSignature String
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, optionSignature])
  @@index([productId])
  @@index([productId, isSoldOut])
}

model ProductImage {
  id              String   @id @default(cuid())
  productId       String
  thumbnailImgUrl String
  detailImgUrl    String[]
  createdAt       DateTime @default(now())
  noticeImgUrl    String?
  product         Product  @relation("ProductImages", fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

// ---------- 주문 / 결제 ----------

model Order {
  id                    String      @id @default(cuid())
  userId                String?
  paymentAmount         Int
  orderDate             DateTime    @default(now())
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  productType           Int? /// /shop 주문의 상품유형(Fund/BuyNow). QR샵 주문은 null
  receiveMethod         Int? /// /shop 주문의 수령방법. QR샵 주문은 null
  receiverName          String?
  receiverPhone         String?
  deliveryZipCode       String?
  deliveryAddressMain   String?
  deliveryAddressDetail String?
  deliveryMessage       String?
  ordererName           String?
  ordererPhone          String?
  paymentStatus         PaymentStatus @default(PENDING) /// 결제상태 (수령상태와 별개 축)
  receiptStatus         ReceiptStatus @default(NOT_RECEIVED) /// 수령상태 (결제상태와 연동하지 않음)
  paymentMethod         PaymentMethod /// 결제방법 (세부 PG 수단은 사이트가 나누지 않음)
  onsitePaymentType     OnsitePaymentType? /// 현장결제 수단(카드/현금/계좌이체). 온라인 결제는 null (DB CHECK로 강제), 이 칸이 생기기 전 현장결제 주문도 null
  cardCompany           Int?
  bankCode              Int?
  easyPayProvider       Int?
  billingKey            String?
  buyerType             BuyerType
  buyerGuestTokenHash   String?     @db.VarChar(128)
  impUid               String?     @unique
  canceledAt            DateTime? /// 취소(환불) 시각
  cancelReason          String? /// 취소 사유 (예: STOCK_SHORTAGE)
  refundFailedAt        DateTime? /// 환불 호출 실패 시각. 값이 있으면 수동 환불 필요
  paidAt                DateTime? /// 결제 시각(PortOne paidAt). QR샵 결제 확정 때 저장, 이 칸이 생기기 전 주문은 null
  refundRequestedAt     DateTime? /// 판매자 환불 요청 시각(전체 주문 조회). 결제완료인데 값이 있으면 환불 처리 중이며 웹훅이나 전체 주문 조회 확인이 마무리한다
  refundRestoreStock    Boolean? /// 판매자 환불 요청 때 고른 재고 복원 여부(웹훅이 마무리할 때 사용)
  refundedByUserId      String? /// 판매자 환불을 요청한 사용자 id(소유자 또는 승인된 직원). 화면에 쓰지 않는 기록용, FK 없음
  inquiries             Inquiry[]
  user                  User?       @relation(fields: [userId], references: [id])
  items                 OrderItem[]
  orderNumber           OrderNumber?

  @@index([userId])
  @@index([productType, receiveMethod])
  @@index([paymentStatus])
  @@index([receiptStatus])
  @@index([orderDate])
  @@index([bankCode])
  @@index([cardCompany])
  @@index([easyPayProvider])
}

/// 주문번호. 주문 1건당 1행이며 (상점, 일자(KST)) 안에서 1부터 순번을 매긴다. /shop 주문은 플레이스홀더 상점(slug goat)의 주문으로 발급한다
model OrderNumber {
  orderId      String    @id
  orderNo      Int? /// 상점·일별 순번 (1부터, 자릿수 고정 없음). QR샵 주문은 결제 확정 때 채우므로 결제 전에는 null
  type         OrderType /// 주문 유형 (QR샵 현장 판매 주문은 ONSITE, /shop 주문은 PRE_ORDER)
  storeId      String
  orderTimeKey String? /// 번호 일자(KST) YYMMDD. QR샵 주문은 결제 시각(Order.paidAt) 기준, 결제 전에는 null
  createdAt    DateTime  @default(now())
  order        Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  store        Store     @relation(fields: [storeId], references: [storeId], onDelete: Cascade)

  @@unique([storeId, orderTimeKey, orderNo])
  @@index([storeId, orderTimeKey])
}

model OrderItem {
  id                String               @id @default(cuid())
  orderId           String
  productId         String? /// /shop 상품. QR샵 주문 항목은 null
  quantity          Int
  price             Int /// 단가 (주문 시점)
  optionData        Json? /// 레거시. 새 로직은 사용하지 않음
  createdAt         DateTime             @default(now())
  onsiteProductId   String?
  onsiteOptionId    String?
  onsiteProductName String? /// 주문 시점 상품명 (상품이 수정·삭제돼도 유지)
  onsiteOptionName  String? /// 주문 시점 옵션명 (옵션 미사용이면 null)
  stockShortage     Boolean              @default(false) /// 결제 완료 후 재고 부족으로 취소된 항목 (품절 환불 화면에 품절 상품만 보여주기 위해 추가)
  order             Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product           Product?             @relation(fields: [productId], references: [id], onDelete: SetNull)
  onsiteProduct     OnsiteProduct?       @relation(fields: [onsiteProductId], references: [productId], onDelete: SetNull)
  onsiteOption      OnsiteProductOption? @relation(fields: [onsiteOptionId], references: [optionId], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
  @@index([onsiteProductId])
  @@index([onsiteOptionId])
}

// ---------- 상품 (QRshop) ----------

/// QRshop 상점
model Store {
  storeId   String  @id @default(cuid())
  userId    String? @unique /// 1인 1상점이므로 unique. 소유자(User)가 삭제되도 판매이력이 있는 상점은 삭제되지 않음 (userId null로 유지, SetNull)
  name      String  @db.VarChar(16)
  storeSlug String  @unique         // 상점URL 식별자
  imageUrl  String? /// 상점 프로필 이미지
  staffInviteCode String @unique @default(cuid()) /// 직원 초대 링크 코드. 공개된 storeSlug 대신 써서 링크를 받은 사람만 권한을 요청하게 한다
  createdAt  DateTime                @default(now())
  updatedAt  DateTime                @updatedAt
  user       User?                   @relation(fields: [userId], references: [id], onDelete: SetNull)
  categories OnsiteProductCategory[]
  products   OnsiteProduct[]
  orderNumbers OrderNumber[]
  staff      StoreStaff[]
}

/// QRshop 상점 직원. 초대 링크로 권한을 요청하고, 소유자가 승인하면 현장 포스·전체 주문 조회를 쓸 수 있다
model StoreStaff {
  id          String           @id @default(cuid())
  storeId     String
  userId      String
  status      StoreStaffStatus @default(PENDING)
  requestedAt DateTime         @default(now()) /// 마지막 권한 요청 시각 (거절된 뒤 다시 요청하면 갱신)
  approvedAt  DateTime? /// 승인 시각 (직원 관리 패널의 등록일)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  store       Store            @relation(fields: [storeId], references: [storeId], onDelete: Cascade)
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([storeId, userId])
  @@index([userId, status])
}

/// QRshop 상점별 상품 카테고리. 상품은 카테고리를 갖지 않을 수 있음
model OnsiteProductCategory {
  categoryId String          @id @default(cuid())
  storeId    String
  name       String
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  store      Store           @relation(fields: [storeId], references: [storeId], onDelete: Cascade)
  products   OnsiteProduct[]

  @@unique([storeId, name])
  @@index([storeId])
}

/// QRshop 상품
model OnsiteProduct {
  productId      String                 @id @default(cuid())
  storeId        String
  categoryId     String?
  name           String                 @db.VarChar(20)
  hasOption      Boolean                @default(false)
  price          Int /// 기본가(0 이상, DB CHECK로 강제). hasOption 여부와 무관하게 항상 존재, 옵션 사용 시 최종가 = price + 옵션 surcharge
  initStock      Int /// 최초 재고(0 이상, DB CHECK로 강제). 옵션 사용 시 옵션 initStock 합계
  currentStock   Int /// 판매 가능 재고(0 이상, DB CHECK로 강제, 결제 확정 시 차감). 옵션 사용 시 옵션 currentStock 합계
  imageUrl       String? /// 상품 대표 이미지
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  store          Store                  @relation(fields: [storeId], references: [storeId], onDelete: Cascade)
  category       OnsiteProductCategory? @relation(fields: [categoryId], references: [categoryId], onDelete: SetNull)
  options        OnsiteProductOption[]
  orderItems     OrderItem[]

  @@index([storeId])
  @@index([categoryId])
}

/// QRshop 상품 옵션. 상품이 hasOption=true 일 때만 사용
model OnsiteProductOption {
  optionId       String        @id @default(cuid())
  productId      String
  name           String        @db.VarChar(18)
  surcharge      Int           @default(0) /// 기본가에 더해지는 추가금(0 이상, 절대가격 아님, DB CHECK로 강제)
  initStock      Int /// 최초 재고(0 이상, DB CHECK로 강제)
  currentStock   Int /// 판매 가능 재고(0 이상, DB CHECK로 강제, 결제 확정 시 차감)
  createdAt      DateTime      @default(now()) /// 등록 시각. 옵션 노출 순서(오래된 등록이 위)의 기준, 같으면 optionId 순
  product        OnsiteProduct @relation(fields: [productId], references: [productId], onDelete: Cascade)
  orderItems     OrderItem[]

  @@unique([productId, name])
  @@index([productId])
}

// ---------- 장바구니 ----------

model Cart {
  id        String     @id @default(cuid())
  userId    String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]

  @@index([userId])
}

model CartItem {
  id         String   @id @default(cuid())
  cartId     String
  productId  String
  quantity   Int      @default(1)
  price      Int
  optionData Json?
  createdAt  DateTime @default(now())
  cart       Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([cartId])
  @@index([productId])
}

// ---------- 프로젝트 (archive) ----------

model ProjectCategory {
  id       String    @id @default(cuid()) @map("categoryId")
  category String
  projects Project[]

  @@map("Project Category")
}

model ProjectYear {
  id       String    @id @default(cuid()) @map("yearId")
  year     Int
  projects Project[]

  @@map("Project Year")
}

model Project {
  title         String
  likeCount     Int             @default(0)
  viewCount     Int             @default(0)
  isPublic      Boolean         @default(false)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  categoryId    String
  detailUrl     String
  hardDeleteAt  DateTime?
  isHome        Boolean         @default(false) @map("ishome")
  id            String          @id @default(cuid()) @map("projectId")
  softDeletedAt DateTime?
  teamId        String
  thumbnailUrl  String
  yearId        String
  likes         Like[]
  category      ProjectCategory @relation(fields: [categoryId], references: [id])
  team          Team            @relation(fields: [teamId], references: [id], onDelete: Cascade)
  projectYear   ProjectYear     @relation(fields: [yearId], references: [id])
  scraps        Scrap[]

  @@index([teamId])
  @@index([categoryId])
  @@index([yearId])
  @@index([isPublic])
  @@index([isHome])
  @@index([softDeletedAt])
}

// ---------- 사용자 활동 (좋아요 / 스크랩 / 알림 / 문의) ----------

model Like {
  id        String   @id @default(cuid())
  userId    String
  productId String?
  projectId String?
  createdAt DateTime @default(now())
  product   Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@unique([userId, projectId])
  @@index([userId])
}

model Scrap {
  id        String   @id @default(cuid())
  userId    String
  projectId String?
  productId String?
  createdAt DateTime @default(now())
  product   Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
  @@unique([userId, productId])
  @@index([userId])
  @@index([projectId])
  @@index([productId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      Int      @default(0)
  title     String
  content   String?
  isRead    Boolean  @default(false)
  linkUrl   String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
}

model Inquiry {
  id        String   @id @default(cuid())
  userId    String
  orderId   String?
  content   String
  status    Int      @default(0)
  createdAt DateTime @default(now())
  order     Order?   @relation(fields: [orderId], references: [id])
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([orderId])
  @@index([status])
}

// ---------- 공통 (이미지 / 인증토큰 / 약관) ----------

model Image {
  id        String   @id @default(cuid()) @map("imageId")
  usage     String
  fileSize  Int
  mimeType  String
  imageUrl  String   @default("")
  data      Bytes?
  createdAt DateTime @default(now())

  @@index([usage])
  @@map("Image")
}

model VerificationToken {
  id         String   @id @default(cuid())
  identifier String
  token      String   @unique
  expires    DateTime
  createdAt  DateTime @default(now())

  @@unique([identifier, token])
  @@index([identifier])
}

model Term {
  id        String   @id @default(cuid())
  type      String
  mainTitle String
  subTitle  String?
  body      String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@index([order])
}

// ---------- Enum ----------

enum SignupMethod {
  EMAIL
  KAKAO
}

enum BuyerType {
  USER
  GUEST
}

enum PaymentStatus {
  PENDING /// 대기
  PAID /// 완료
  CANCELED /// 취소
  FAILED /// 실패
}

enum PaymentMethod {
  ONLINE /// 온라인결제
  ON_SITE /// 현장결제
}

enum ReceiptStatus {
  NOT_RECEIVED /// 미수령
  RECEIVED /// 수령완료
}

enum OrderType {
  PRE_ORDER /// /shop 주문(플레이스홀더 상점). 사전주문도 이 값을 쓸 예정
  ONSITE /// 현장판매 (QR샵 주문)
}

enum OnsitePaymentType {
  CARD /// 카드
  CASH /// 현금
  TRANSFER /// 계좌이체
}

enum StoreStaffStatus {
  PENDING /// 승인 대기
  APPROVED /// 승인됨 (등록된 직원)
  REJECTED /// 거절됨 (다시 요청 가능)
}
