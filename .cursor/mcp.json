{
  "mcpServers": {
    "figma": {
      "url": "http://127.0.0.1:3845/mcp",
      "headers": {
        "Authorization": "Bearer ${env:FIGMA_ACCESS_TOKEN}"
      }
    },
    "notion": {
      "command": "npx",
      "args": ["-y", "@notionhq/notion-mcp-server"],
      "env": {
        "OPENAPI_MCP_HEADERS": "{\"Authorization\": \"Bearer ${env:NOTION_TOKEN}\", \"Notion-Version\": \"2022-06-28\"}"
      }
    },
    "erdcloud": {
      "url": "${env:ERDCLOUD_MCP_URL}",
      "headers": {
        "Authorization": "Bearer ${env:ERDCLOUD_MCP_TOKEN}"
      }
    }
  }
}
